# --- Server (CalendarServer) ---
CAL_SERVER_HOST=127.0.0.1
CAL_SERVER_PORT=8011
CAL_SERVER_RELOAD=1
CAL_SECRET_KEY=change-me-generate-a-random-value
CAL_BOT_SECRET=change-me
CAL_TOKEN_EXPIRE_MINUTES=60

# --- Client (CalendarDesktop / future CalendarWeb) ---
CAL_SERVER_URL=http://127.0.0.1:8011

# --- Versions / installer ---
# MIN_PROTOCOL ниже PROTOCOL = разрешить старые клиенты; по умолчанию строго
MIN_PROTOCOL=
INSTALLER_URL=https://github.com/Zetroks/R_Cal/releases

# --- Google Calendar (server-side sync, secrets live outside repo) ---
GOOGLE_CLIENT_SECRET_FILE=CalendarServer/.google_client_secret.json
GOOGLE_TOKEN_FILE=CalendarServer/.google_token.json
# целевой календарь выбирает пользователь (виден в Google Calendar -> настройки календаря -> ID)
GOOGLE_TARGET_CALENDAR_ID=

# --- Telegram bot (токен от BotFather, сюда только путь/пусто — сам токен в .env) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Апдейт удалённого бокса по SSH (forced command, шелла нет).
# Если не задано — бот обновляет локальный бокс через UPDATE_SCRIPT.
UPDATE_SSH_HOST=
UPDATE_SSH_USER=updater
UPDATE_SSH_KEY_FILE=
