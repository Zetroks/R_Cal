[Unit]
Description=R_Cal Telegram bot
After=network.target calendar-server.service
Wants=calendar-server.service

[Service]
Type=simple
# user-юнит: положить в ~/.config/systemd/user/, поправить путь
WorkingDirectory=/opt/r_cal
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/r_cal/.venv/bin/python -m CalendarBot.bot
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
